# Copia este archivo como .env y completa los valores reales.
# No subas nunca el archivo .env al repositorio.

DB_URL=jdbc:postgresql://HOST:5432/NOMBRE_BD?sslmode=require
DB_USERNAME=usuario
DB_PASSWORD=contrasena

# Orígenes permitidos para CORS (separados por coma). En producción puede ser la URL del frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
